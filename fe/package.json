{
  "name": "fe",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/admin",
    "apps/client",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=admin",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev:admin\" \"npm run dev:client\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.0.0"
  },
